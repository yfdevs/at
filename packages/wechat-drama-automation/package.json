{
  "name": "@drama/wechat-drama-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm --filter @drama/axios build && pnpm --filter @drama/feishu-notifier build && vp pack",
    "check": "tsc --noEmit",
    "test": "tsx --conditions=development --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@drama/axios": "workspace:*",
    "@drama/automation-logging": "workspace:*",
    "@drama/drama-media-assets": "workspace:*",
    "@drama/feishu-notifier": "workspace:*",
    "p-queue": "^9.3.3",
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "latest",
    "fast-glob": "^3.3.3",
    "tsx": "latest",
    "typescript": "^6.0.3",
    "vite": "catalog:"
  }
}
