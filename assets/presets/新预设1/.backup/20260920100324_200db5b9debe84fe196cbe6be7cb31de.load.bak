        },
        "translate_original_text": "你身手这么好"
      },
      {
        "id": "fa3bb6ef7a4544eebf88f251117467b3",
        "type": "subtitle",
        "content": "{\"text\":\"给我孙子做保镖吧\",\"styles\":[{\"size\":8,\"fill\":{\"content\":{\"render_type\":\"solid\",\"solid\":{\"color\":[1,1,1]}}},\"range\":[0,8]}]}",
