        "lyrics_template": {
          "resource_id": "",
          "path": ""
        },
        "translate_original_text": "给我孙子做保镖吧"
      },
      {
        "id": "074e504326524066aeba209711e24d61",
        "type": "subtitle",
        "content": "{\"text\":\"一个月多少工资\",\"styles\":[{\"size\":8,\"fill\":{\"content\":{\"render_type\":\"solid\",\"solid\":{\"color\":[1,1,1]}}},\"range\":[0,7]}]}",
